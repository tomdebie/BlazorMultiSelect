@typeparam TItem
@inherits InputBase<List<TItem>>



<div class="custom-select-wrapper mb-2">
    <div class="custom-select-button"
         role="combobox"
         aria-expanded="false"
         aria-haspopup="listbox"
         aria-controls="vrijwilligerkorps-listbox"
         aria-labelledby="vrijwilligerkorps-label"
         id="vrijwilligerkorps-button"
    @onclick="Test">
        <div class="selected-items" aria-live="polite" aria-atomic="true"></div>
    </div>
    <label class="floating-label" id="vrijwilligerkorps-label">Vrijwilligerkorps</label>
    <span class="visually-hidden" id="vrijwilligerkorps-instructions">
        Use arrow keys to navigate options, Space or Enter to select, Escape to close
    </span>
    <div class="custom-dropdown"
         role="listbox"
         aria-labelledby="vrijwilligerkorps-label"
         aria-multiselectable="true"
         id="vrijwilligerkorps-listbox"
         aria-hidden="true">

        @for (int i = 0; i < Data.Count; i++)
        {
            var item = Data[i];
            var value = GetValue(item);            // string key for id/value
            var displayValue = GetDisplayValue(item);
            var id = $"option-{i}-{value}";        // ensure unique id
                                                   //"
            <div class="dropdown-option" role="option" aria-selected="@IsChecked(item)"  tabindex="-1" data-value="@value">
                <input @key="item" type="checkbox" id="@id"
                       checked="@IsChecked(item)"
                       @onchange="@(e => OnCheckboxChanged(item, e))" />
                                                       @* @onclick="() => Toggle(item)" *@
                <label for="@id">@displayValue</label>
            </div>
        }
    </div>
    <div class="sr-status" role="status" aria-live="polite" aria-atomic="true"></div>
</div>

<script>
    const selectButton = document.querySelector('.custom-select-button');
    const dropdown = document.querySelector('.custom-dropdown');
    const floatingLabel = document.querySelector('.floating-label');
    const selectedItemsContainer = document.querySelector('.selected-items');
    const options = document.querySelectorAll('.dropdown-option[role="option"]');
    const srStatus = document.querySelector('.sr-status');
    let currentFocusIndex = -1;
    let typeAheadBuffer = '';
    let typeAheadTimeout;

    // Toggle dropdown
    function toggleDropdown(open) {
        const isOpen = open !== undefined ? open : dropdown.getAttribute('aria-hidden') === 'true';

        dropdown.setAttribute('aria-hidden', !isOpen);
        selectButton.setAttribute('aria-expanded', isOpen);

        if (isOpen) {
            // Set focus to first selected item or first item
            const firstSelected = Array.from(options).find(opt => opt.getAttribute('aria-selected') === 'true');
            currentFocusIndex = firstSelected ? Array.from(options).indexOf(firstSelected) : 0;
            setFocusToOption(currentFocusIndex);
        } else {
            currentFocusIndex = -1;
            selectButton.focus();
        }
    }

    selectButton.addEventListener('click', (e) => {
        //e.stopPropagation();
        toggleDropdown();
    });

    // Close dropdown when clicking outside
    // document.addEventListener('click', (e) => {
    //     if (!e.target.closest('.custom-select-wrapper')) {
    //         toggleDropdown(false);
    //     }
    // });

    // Keyboard navigation for button
    selectButton.addEventListener('keydown', (e) => {
        switch (e.key) {
            case 'Enter':
            case ' ':
            case 'ArrowDown':
            case 'ArrowUp':
                e.preventDefault();
                toggleDropdown(true);
                break;
            case 'Escape':
                toggleDropdown(false);
                break;
        }
    });

    // Set focus to specific option
    function setFocusToOption(index) {
        if (index >= 0 && index < options.length) {
            options.forEach(opt => opt.setAttribute('tabindex', '-1'));
            options[index].setAttribute('tabindex', '0');
            options[index].focus();
            currentFocusIndex = index;
        }
    }

    // Keyboard navigation for dropdown
    dropdown.addEventListener('keydown', (e) => {
        const optionsArray = Array.from(options);

        switch (e.key) {
            case 'ArrowDown':
                e.preventDefault();
                currentFocusIndex = (currentFocusIndex + 1) % optionsArray.length;
                setFocusToOption(currentFocusIndex);
                break;

            case 'ArrowUp':
                e.preventDefault();
                currentFocusIndex = currentFocusIndex <= 0 ? optionsArray.length - 1 : currentFocusIndex - 1;
                setFocusToOption(currentFocusIndex);
                break;

            case 'Home':
                e.preventDefault();
                setFocusToOption(0);
                break;

            case 'End':
                e.preventDefault();
                setFocusToOption(optionsArray.length - 1);
                break;

            case 'Escape':
                e.preventDefault();
                toggleDropdown(false);
                break;

            case 'Tab':
                toggleDropdown(false);
                break;

            case ' ':
            case 'Enter':
                e.preventDefault();
                if (document.activeElement.classList.contains('dropdown-option')) {
                    toggleOption(document.activeElement);
                }
                break;

            default:
                // Type-ahead functionality
                if (e.key.length === 1) {
                    e.preventDefault();
                    handleTypeAhead(e.key);
                }
        }
    });

    // Type-ahead search
    function handleTypeAhead(char) {
        clearTimeout(typeAheadTimeout);
        typeAheadBuffer += char.toLowerCase();

        const matchingIndex = Array.from(options).findIndex((opt, idx) => {
            const text = opt.querySelector('label').textContent.toLowerCase();
            return idx > currentFocusIndex && text.startsWith(typeAheadBuffer);
        });

        if (matchingIndex !== -1) {
            setFocusToOption(matchingIndex);
        } else {
            // Search from beginning
            const matchFromStart = Array.from(options).findIndex(opt => {
                const text = opt.querySelector('label').textContent.toLowerCase();
                return text.startsWith(typeAheadBuffer);
            });
            if (matchFromStart !== -1) {
                setFocusToOption(matchFromStart);
            }
        }

        typeAheadTimeout = setTimeout(() => {
            typeAheadBuffer = '';
        }, 500);
    }

    // Handle clicking on dropdown options
    options.forEach((option, index) => {
        option.addEventListener('click', function () {
            toggleOption(this);
        });
    });

    function toggleOption(optionElement) {
        const checkbox = optionElement.querySelector('input[type="checkbox"]');
        checkbox.checked = !checkbox.checked;
        optionElement.setAttribute('aria-selected', checkbox.checked);
        updateSelectedItems();
    }

    function updateSelectedItems() {
        const selected = Array.from(options)
            .filter(opt => opt.getAttribute('aria-selected') === 'true')
            .map(opt => opt.getAttribute('data-value'));

        if (selected.length > 0) {
            floatingLabel.classList.add('has-value');
            selectedItemsContainer.textContent = selected.join(', ');

            // Update ARIA label
            const selectionText = `${selected.length} item${selected.length > 1 ? 's' : ''} selected: ${selected.join(', ')}`;
            selectButton.setAttribute('aria-label', `Vrijwilligerkorps, ${selectionText}`);

            // Announce to screen readers
            announceToScreenReader(selectionText);
        } else {
            floatingLabel.classList.remove('has-value');
            selectedItemsContainer.textContent = '';
            selectButton.setAttribute('aria-label', 'Vrijwilligerkorps, no items selected');
            announceToScreenReader('No items selected');
        }
    }

    function announceToScreenReader(message) {
        srStatus.textContent = message;
        setTimeout(() => {
            srStatus.textContent = '';
        }, 1000);
    }

    // Prevent dropdown from closing when clicking inside
    dropdown.addEventListener('click', (e) => {
        e.stopPropagation();
    });
</script>