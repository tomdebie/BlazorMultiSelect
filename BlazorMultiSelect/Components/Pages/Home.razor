@page "/"
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.

<h3>Multi-Select Dropdown Demo</h3>

<EditForm Model="@model" OnValidSubmit="Submit">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label class="form-label">Select Fruits:</label>
        <InputMultiSelectDropdown TItem="Fruit" TValue="string"
                                  Items="@Fruits"
                                  @bind-Value="@model.SelectedFruitIds"
                                  ValueSelector="x => x.Id"
                                  TextSelector="x => x.Name"
                                  Placeholder="Select fruits..." />
        <ValidationMessage For="@(() => model.SelectedFruitIds)" />
    </div>

    <button class="btn btn-primary" type="submit">Submit</button>
</EditForm>

<p class="mt-3">
    <strong>Selected Fruits:</strong> @string.Join(", ", SelectedFruitNames)
</p>
