<button @onclick="HideAndShow">Hide and show</button>

<EditForm Model="@model" OnValidSubmit="Submit">
    <DataAnnotationsValidator />

    <MultiselectComponent TItem="Spaceship"
                          Data="@AvailableSpaceships"
                          TextField="@nameof(Spaceship.Name)"
                          ValueField="@nameof(Spaceship.Id)"
                          @bind-Value="SelectedStarships2" />

    @if (ShowSpaceshipMultiSelect)
    {
        <RkMultiSelect Id="spaceship"
                       Label="Space ship"
                       IsRequired="true"
                       Items="@AvailableSpaceships"
                       ValueSelector="x => x.Id"
                       DisplayTextSelector="x => x.Name"
                       @bind-Value="model.SelectedSpaceships" />
    }

    <RkMultiSelect Id="fruit"
                   Label="Fruit"
                   IsRequired="false"
                   Items="@AvailableFruits"
                   ValueSelector="x => x.Id"
                   DisplayTextSelector="x => x.Name"
                   @bind-Value="model.SelectedFruits" />

    <div class="form-floating mb-3">
        <input type="email" class="form-control form-control-lg" id="floatingInput" placeholder="name@example.com">
        <label for="floatingInput">Email address</label>
    </div>

    <button class="btn btn-primary" type="submit">Submit</button>
</EditForm>


<p>
    @Output
</p>

<p>
    @OutputFuits
</p>
